--[[
	The item catalogue.

	Id      - permanent save key. NEVER rename an Id once the game is live (saved items point at it).
	          Renaming Name is safe.
	Rarity  - a Rarities.luau Id.
	Value   - base value before brand and mutation multipliers.
	Weight  - how often this item is picked relative to the other items of the same rarity.
	Icon    - emoji fallback shown until you upload artwork.
	Image   - "rbxassetid://..." artwork. Leave "" to use Icon.
	Brands  - Brands.luau Ids that can roll on this item.
]]

export type Item = {
	Id: string,
	Name: string,
	Rarity: string,
	Value: number,
	Weight: number,
	Icon: string,
	Image: string,
	Brands: { string },
}

